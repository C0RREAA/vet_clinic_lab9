<%
  show_pet_field = current_user&.admin? || current_user&.vet? || (current_user&.owner? && appointment.new_record?)
  # Vets never pick vet_id: it's forced to themselves on create and locked on update.
  show_vet_field = current_user&.admin? || current_user&.owner?
  pets_scope = if current_user&.admin? || current_user&.vet?
                 Pet.includes(:owner).all
               elsif current_user&.owner? && current_user.owner
                 current_user.owner.pets
               else
                 Pet.none
               end
%>

<%= form_with(model: appointment, local: true) do |f| %>
  <%= render "shared/error_messages", object: appointment %>

  <div class="mb-3">
    <%= f.label :date, class: "form-label" %>
    <%= f.datetime_field :date, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :reason, class: "form-label" %>
    <%= f.text_area :reason, class: "form-control", rows: 3 %>
  </div>

  <div class="mb-3">
    <%= f.label :status, class: "form-label" %>
    <%= f.select :status,
                 Appointment.statuses.keys.map { |s| [s.humanize, s] },
                 { include_blank: "Select status" },
                 class: "form-select" %>
  </div>

  <% if show_pet_field %>
    <div class="mb-3">
      <%= f.label :pet_id, "Pet", class: "form-label" %>
      <%= f.collection_select :pet_id, pets_scope,
                              :id,
                              ->(p) { p.owner ? "#{p.name} (#{p.owner.first_name} #{p.owner.last_name})" : p.name },
                              { include_blank: "Select pet" },
                              class: "form-select" %>
    </div>
  <% elsif appointment.pet %>
    <div class="mb-3">
      <label class="form-label">Pet</label>
      <input type="text" class="form-control" value="<%= appointment.pet.name %>" disabled>
    </div>
  <% end %>

  <% if show_vet_field %>
    <div class="mb-3">
      <%= f.label :vet_id, "Vet", class: "form-label" %>
      <%= f.collection_select :vet_id, Vet.all,
                              :id,
                              ->(v) { "#{v.first_name} #{v.last_name}" },
                              { include_blank: "Select vet" },
                              class: "form-select" %>
    </div>
  <% elsif appointment.vet %>
    <div class="mb-3">
      <label class="form-label">Vet</label>
      <input type="text" class="form-control" value="<%= "#{appointment.vet.first_name} #{appointment.vet.last_name}" %>" disabled>
    </div>
  <% end %>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", appointments_path, class: "btn btn-secondary" %>
  </div>
<% end %>
