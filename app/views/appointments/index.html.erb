<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="m-0">Appointments</h1>
  <% if policy(Appointment.new).new? %>
    <%= link_to "New Appointment", new_appointment_path, class: "btn btn-primary" %>
  <% end %>
</div>

<table class="table table-bordered table-hover align-middle">
  <thead class="table-dark">
    <tr>
      <th>Date</th>
      <th>Pet</th>
      <th>Vet</th>
      <th>Reason</th>
      <th>Status</th>
      <th class="text-end">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @appointments.each do |appt| %>
      <tr>
        <td><%= link_to appt.date.strftime("%B %d, %Y %H:%M"), appointment_path(appt) %></td>
        <td><%= appt.pet ? link_to(appt.pet.name, pet_path(appt.pet)) : "-" %></td>
        <td><%= appt.vet ? link_to("#{appt.vet.first_name} #{appt.vet.last_name}", vet_path(appt.vet)) : "-" %></td>
        <td><%= appt.reason %></td>
        <td>
          <% statuses = { "scheduled" => ["Scheduled", "primary"], "in_progress" => ["In Progress", "warning"], "completed" => ["Completed", "success"], "cancelled" => ["Cancelled", "danger"] } %>
          <% s = statuses[appt.status] || ["Unknown", "secondary"] %>
          <span class="badge bg-<%= s[1] %>"><%= s[0] %></span>
        </td>
        <td class="text-end">
          <% if policy(appt).edit? %>
            <%= link_to "Edit", edit_appointment_path(appt), class: "btn btn-sm btn-outline-secondary" %>
          <% end %>
          <% if policy(appt).destroy? %>
            <%= button_to "Delete", appointment_path(appt),
                          method: :delete,
                          class: "btn btn-sm btn-outline-danger d-inline",
                          form: { class: "d-inline" },
                          data: { turbo_confirm: "Are you sure?" } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
