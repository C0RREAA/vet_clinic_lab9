<%= link_to "← Back to Appointments", appointments_path, class: "btn btn-secondary mb-3" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="m-0">Appointment — <%= @appointment.date.strftime("%B %d, %Y") %></h1>
  <div class="d-flex gap-2">
    <% if policy(@appointment).edit? %>
      <%= link_to "Edit", edit_appointment_path(@appointment), class: "btn btn-outline-secondary" %>
    <% end %>
    <% if policy(@appointment).destroy? %>
      <%= button_to "Delete", appointment_path(@appointment),
                    method: :delete,
                    class: "btn btn-outline-danger",
                    form: { class: "d-inline" },
                    data: { turbo_confirm: "Are you sure?" } %>
    <% end %>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <p><strong>Date:</strong> <%= @appointment.date.strftime("%B %d, %Y %H:%M") %></p>
    <p><strong>Reason:</strong> <%= @appointment.reason %></p>
    <p><strong>Status:</strong>
      <% statuses = { "scheduled" => ["Scheduled", "primary"], "in_progress" => ["In Progress", "warning"], "completed" => ["Completed", "success"], "cancelled" => ["Cancelled", "danger"] } %>
      <% s = statuses[@appointment.status] || ["Unknown", "secondary"] %>
      <span class="badge bg-<%= s[1] %>"><%= s[0] %></span>
    </p>
    <p><strong>Pet:</strong> <%= @appointment.pet ? link_to(@appointment.pet.name, pet_path(@appointment.pet)) : "-" %></p>
    <p><strong>Vet:</strong> <%= @appointment.vet ? link_to("#{@appointment.vet.first_name} #{@appointment.vet.last_name}", vet_path(@appointment.vet)) : "-" %></p>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h4 class="m-0">Treatments</h4>
  <% if policy(Treatment.new(appointment: @appointment)).create? %>
    <%= link_to "New Treatment", new_appointment_treatment_path(@appointment), class: "btn btn-primary btn-sm" %>
  <% end %>
</div>

<% if @appointment.treatments.any? %>
  <% @appointment.treatments.each do |t| %>
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <h5 class="card-title m-0"><%= t.name %></h5>
          <div class="d-flex gap-2">
            <% if policy(t).edit? %>
              <%= link_to "Edit", edit_appointment_treatment_path(@appointment, t),
                                  class: "btn btn-sm btn-outline-secondary" %>
            <% end %>
            <% if policy(t).destroy? %>
              <%= button_to "Delete", appointment_treatment_path(@appointment, t),
                            method: :delete,
                            class: "btn btn-sm btn-outline-danger",
                            form: { class: "d-inline" },
                            data: { turbo_confirm: "Are you sure?" } %>
            <% end %>
          </div>
        </div>
        <p class="text-muted small mb-2">
          <strong>Medication:</strong> <%= t.medication.presence || "—" %>
          &nbsp;·&nbsp;
          <strong>Dosage:</strong> <%= t.dosage.presence || "—" %>
          &nbsp;·&nbsp;
          <strong>Administered:</strong> <%= t.administered_at.strftime("%B %d, %Y %H:%M") %>
        </p>
        <% if t.clinical_notes.present? %>
          <div class="trix-content">
            <%= t.clinical_notes %>
          </div>
        <% else %>
          <p class="text-muted fst-italic mb-0">No clinical notes recorded.</p>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <p class="text-muted">No treatments recorded for this appointment.</p>
<% end %>
