<nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #1a1a2e;">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">🐾 VetClinic</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto">
        <% if user_signed_in? %>
          <% if current_user.admin? || current_user.vet? %>
            <li class="nav-item">
              <%= link_to "Owners", owners_path, class: "nav-link" %>
            </li>
          <% elsif current_user.owner? && current_user.owner %>
            <li class="nav-item">
              <%= link_to "My account", owner_path(current_user.owner), class: "nav-link" %>
            </li>
          <% end %>
          <li class="nav-item">
            <%= link_to "Pets", pets_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Vets", vets_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Appointments", appointments_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>

      <ul class="navbar-nav ms-auto align-items-lg-center">
        <% if user_signed_in? %>
          <li class="nav-item">
            <span class="navbar-text text-white-50 me-2">
              <%= "#{current_user.first_name} #{current_user.last_name}" %>
              <span class="badge bg-secondary ms-1"><%= current_user.role %></span>
            </span>
          </li>
          <li class="nav-item">
            <%= button_to "Sign out",
                          destroy_user_session_path,
                          method: :delete,
                          class: "btn btn-outline-light btn-sm",
                          form: { class: "d-inline" } %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Sign in", new_user_session_path, class: "nav-link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
