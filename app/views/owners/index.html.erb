<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="m-0">Owners</h1>
  <% if policy(Owner.new).create? %>
    <%= link_to "New Owner", new_owner_path, class: "btn btn-primary" %>
  <% end %>
</div>

<table class="table table-bordered table-hover align-middle">
  <thead class="table-dark">
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Phone</th>
      <th>Pets</th>
      <th class="text-end">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @owners.each do |owner| %>
      <tr>
        <td><%= link_to "#{owner.first_name} #{owner.last_name}", owner_path(owner) %></td>
        <td><%= owner.email %></td>
        <td><%= owner.phone %></td>
        <td><%= owner.pets.count %></td>
        <td class="text-end">
          <% if policy(owner).edit? %>
            <%= link_to "Edit", edit_owner_path(owner), class: "btn btn-sm btn-outline-secondary" %>
          <% end %>
          <% if policy(owner).destroy? %>
            <%= button_to "Delete", owner_path(owner),
                          method: :delete,
                          class: "btn btn-sm btn-outline-danger d-inline",
                          form: { class: "d-inline" },
                          data: { turbo_confirm: "Are you sure?" } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
