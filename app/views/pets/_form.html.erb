<%= form_with(model: pet, local: true) do |f| %>
  <%= render "shared/error_messages", object: pet %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :species, class: "form-label" %>
    <%= f.select :species,
                 Pet::SPECIES.map { |s| [s.capitalize, s] },
                 { include_blank: "Select species" },
                 class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= f.label :breed, class: "form-label" %>
    <%= f.text_field :breed, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :date_of_birth, class: "form-label" %>
    <%= f.date_field :date_of_birth, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :weight, "Weight (kg)", class: "form-label" %>
    <%= f.number_field :weight, step: 0.1, class: "form-control" %>
  </div>

  <% if current_user&.admin? %>
    <div class="mb-3">
      <%= f.label :owner_id, "Owner", class: "form-label" %>
      <%= f.collection_select :owner_id, Owner.all,
                              :id,
                              ->(o) { "#{o.first_name} #{o.last_name}" },
                              { include_blank: "Select owner" },
                              class: "form-select" %>
    </div>
  <% elsif current_user&.owner? && current_user.owner %>
    <div class="mb-3">
      <label class="form-label">Owner</label>
      <input type="text" class="form-control" value="<%= "#{current_user.owner.first_name} #{current_user.owner.last_name}" %>" disabled>
      <small class="form-text text-muted">Pets you create are linked to your own owner record.</small>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :photo, class: "form-label" %>
    <% if pet.persisted? && pet.photo.attached? %>
      <div class="mb-2">
        <small class="text-muted d-block mb-1">Current photo</small>
        <%= image_tag pet.photo, width: 100, class: "rounded border" %>
      </div>
    <% end %>
    <%= f.file_field :photo, class: "form-control", accept: "image/jpeg,image/png,image/webp" %>
    <small class="form-text text-muted">JPEG, PNG, or WebP up to 5 MB.</small>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", pets_path, class: "btn btn-secondary" %>
  </div>
<% end %>
