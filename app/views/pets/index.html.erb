<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="m-0">Pets</h1>
  <% if policy(Pet.new).create? %>
    <%= link_to "New Pet", new_pet_path, class: "btn btn-primary" %>
  <% end %>
</div>

<table class="table table-bordered table-hover align-middle">
  <thead class="table-dark">
    <tr>
      <th>Photo</th>
      <th>Name</th>
      <th>Species</th>
      <th>Breed</th>
      <th>Owner</th>
      <th>Date of Birth</th>
      <th class="text-end">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @pets.each do |pet| %>
      <tr>
        <td>
          <% if pet.photo.attached? %>
            <%= image_tag pet.photo.variant(resize_to_fill: [ 60, 60 ]), class: "rounded" %>
          <% else %>
            <span class="text-muted">—</span>
          <% end %>
        </td>
        <td><%= link_to pet.name, pet_path(pet) %></td>
        <td><%= pet.species %></td>
        <td><%= pet.breed %></td>
        <td><%= pet.owner ? link_to("#{pet.owner.first_name} #{pet.owner.last_name}", owner_path(pet.owner)) : "-" %></td>
        <td><%= pet.date_of_birth.strftime("%B %d, %Y") %></td>
        <td class="text-end">
          <% if policy(pet).edit? %>
            <%= link_to "Edit", edit_pet_path(pet), class: "btn btn-sm btn-outline-secondary" %>
          <% end %>
          <% if policy(pet).destroy? %>
            <%= button_to "Delete", pet_path(pet),
                          method: :delete,
                          class: "btn btn-sm btn-outline-danger d-inline",
                          form: { class: "d-inline" },
                          data: { turbo_confirm: "Are you sure?" } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
