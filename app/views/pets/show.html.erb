<%= link_to "← Back to Pets", pets_path, class: "btn btn-secondary mb-3" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="m-0"><%= @pet.name %></h1>
  <div class="d-flex gap-2">
    <% if policy(@pet).edit? %>
      <%= link_to "Edit", edit_pet_path(@pet), class: "btn btn-outline-secondary" %>
    <% end %>
    <% if policy(@pet).destroy? %>
      <%= button_to "Delete", pet_path(@pet),
                    method: :delete,
                    class: "btn btn-outline-danger",
                    form: { class: "d-inline" },
                    data: { turbo_confirm: "Are you sure?" } %>
    <% end %>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <div class="mb-3">
      <% if @pet.photo.attached? %>
        <%= image_tag @pet.photo, width: 300, class: "img-fluid rounded" %>
      <% else %>
        <div class="text-muted fst-italic border rounded p-4 bg-light text-center" style="max-width: 300px;">
          No photo available
        </div>
      <% end %>
    </div>
    <p><strong>Species:</strong> <%= @pet.species %></p>
    <p><strong>Breed:</strong> <%= @pet.breed %></p>
    <p><strong>Date of Birth:</strong> <%= @pet.date_of_birth.strftime("%B %d, %Y") %></p>
    <p><strong>Weight:</strong> <%= @pet.weight %> kg</p>
    <p><strong>Owner:</strong> <%= link_to "#{@pet.owner.first_name} #{@pet.owner.last_name}", owner_path(@pet.owner) %></p>
  </div>
</div>

<h4>Appointments</h4>
<table class="table table-bordered table-hover">
  <thead class="table-dark">
    <tr><th>Date</th><th>Reason</th><th>Status</th></tr>
  </thead>
  <tbody>
    <% @pet.appointments.each do |appt| %>
      <tr>
        <td><%= link_to appt.date.strftime("%B %d, %Y %H:%M"), appointment_path(appt) %></td>
        <td><%= appt.reason %></td>
        <td><%= appt.status.to_s.humanize %></td>
      </tr>
    <% end %>
  </tbody>
</table>
