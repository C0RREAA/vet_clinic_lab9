<%= link_to "← Back to Vets", vets_path, class: "btn btn-secondary mb-3" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="m-0">Dr. <%= @vet.first_name %> <%= @vet.last_name %></h1>
  <div class="d-flex gap-2">
    <% if policy(@vet).edit? %>
      <%= link_to "Edit", edit_vet_path(@vet), class: "btn btn-outline-secondary" %>
    <% end %>
    <% if policy(@vet).destroy? %>
      <%= button_to "Delete", vet_path(@vet),
                    method: :delete,
                    class: "btn btn-outline-danger",
                    form: { class: "d-inline" },
                    data: { turbo_confirm: "Are you sure?" } %>
    <% end %>
  </div>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <p><strong>Email:</strong> <%= @vet.email %></p>
    <p><strong>Phone:</strong> <%= @vet.phone %></p>
    <p><strong>Specialization:</strong> <%= @vet.specialization %></p>
  </div>
</div>

<h4>Upcoming Appointments</h4>
<% if @upcoming.any? %>
  <table class="table table-bordered table-hover mb-4">
    <thead class="table-dark">
      <tr><th>Date</th><th>Pet</th><th>Reason</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% @upcoming.each do |appt| %>
        <tr>
          <td><%= link_to appt.date.strftime("%B %d, %Y %H:%M"), appointment_path(appt) %></td>
          <td><%= link_to appt.pet.name, pet_path(appt.pet) %></td>
          <td><%= appt.reason %></td>
          <td><span class="badge bg-primary"><%= appt.status.humanize %></span></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted mb-4">No upcoming appointments.</p>
<% end %>

<h4>Past Appointments</h4>
<% if @past.any? %>
  <table class="table table-bordered table-hover">
    <thead class="table-dark">
      <tr><th>Date</th><th>Pet</th><th>Reason</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% @past.each do |appt| %>
        <tr>
          <td><%= link_to appt.date.strftime("%B %d, %Y %H:%M"), appointment_path(appt) %></td>
          <td><%= link_to appt.pet.name, pet_path(appt.pet) %></td>
          <td><%= appt.reason %></td>
          <td>
            <% color = { "completed" => "success", "cancelled" => "danger", "in_progress" => "warning" }[appt.status] || "secondary" %>
            <span class="badge bg-<%= color %>"><%= appt.status.humanize %></span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No past appointments.</p>
<% end %>